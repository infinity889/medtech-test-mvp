FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install dependencies from pyproject.toml without leaving editable egg-info in bind-mounted /app
COPY pyproject.toml /tmp/pyproject.toml
RUN python - <<'PY'
import subprocess
import tomllib

with open("/tmp/pyproject.toml", "rb") as f:
    data = tomllib.load(f)

deps = list(data["project"]["dependencies"])
deps.extend(data["project"]["optional-dependencies"]["dev"])
subprocess.check_call(["pip", "install", "--upgrade", "pip"])
subprocess.check_call(["pip", "install", *deps])
PY
RUN rm -f /tmp/pyproject.toml

CMD ["python", "--version"]
